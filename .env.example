# Copy this file to ".env" (in the repository root) and fill in your own values.
# The backend reads it automatically on startup; real environment variables override it.
# Do not wrap values in quotes. Never commit the .env file.

# ---- MySQL connection ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=employee_management
DB_USERNAME=ems_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Administrator account (created on first startup if the username does not exist) ----
# The password is stored only as a BCrypt hash. Minimum 8 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---- Optional ----
# Insert 24 sample employees (all @example.com) when the employees table is empty.
SEED_DEMO_DATA=true
# Browser origin allowed to call the API directly (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173
SERVER_PORT=8080
