{
  "info": {
    "name": "Employee Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Login and the full employee CRUD lifecycle, including search, filters, pagination and failure cases.\n\nSetup: set the collection variables `baseUrl` (default http://localhost:8080), `username` and `password` to the ADMIN_USERNAME / ADMIN_PASSWORD you configured in .env. Then run the collection in order with the Collection Runner.\n\nAuthentication uses the JSESSIONID session cookie. CSRF: every response's XSRF-TOKEN cookie is copied into the `xsrfToken` variable by the collection test script and sent as the X-XSRF-TOKEN header on POST/PUT/DELETE."
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Keep {{xsrfToken}} in sync with the latest XSRF-TOKEN cookie (it is rotated on login and logout).",
          "const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
          "if (xsrfCookie) { pm.collectionVariables.set('xsrfToken', xsrfCookie); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "xsrfToken",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Get CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));",
                  "pm.test('XSRF cookie issued', () => pm.expect(pm.cookies.get('XSRF-TOKEN')).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "csrf"
              ]
            },
            "description": "Sets the XSRF-TOKEN cookie. The collection test script copies it into {{xsrfToken}}, which is sent as the X-XSRF-TOKEN header on POST/PUT/DELETE."
          }
        },
        {
          "name": "Login - wrong password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message', () => pm.expect(pm.response.json().message).to.eql('Invalid username or password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Failed logins return a generic 401 that does not reveal whether the username exists.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "definitely-wrong",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Logged in as configured user', () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('username')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Form-encoded login. On success the server sets the JSESSIONID session cookie (Postman keeps it automatically).",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has ADMIN role', () => pm.expect(pm.response.json().roles).to.include('ADMIN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Returns the logged-in user. Also refreshes the XSRF token, which is rotated on login."
          }
        }
      ]
    },
    {
      "name": "2. Employee CRUD, search and pagination",
      "item": [
        {
          "name": "List employees (first page)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Paged response shape', () => { pm.expect(body).to.have.keys('content','page','size','totalElements','totalPages','first','last'); pm.expect(body.page).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Zero-based pagination with default size 10, sorted by id ascending."
          }
        },
        {
          "name": "Search by name or email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Every result matches the search term', () => pm.response.json().content.forEach(e => pm.expect((e.fullName + ' ' + e.email).toLowerCase()).to.include('sharma')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search=sharma",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "sharma"
                }
              ]
            },
            "description": "Case-insensitive match on full name OR email."
          }
        },
        {
          "name": "Filter by department and status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('All results match both filters', () => pm.response.json().content.forEach(e => { pm.expect(e.department).to.eql('Engineering'); pm.expect(e.employmentStatus).to.eql('ACTIVE'); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?department=Engineering&status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "department",
                  "value": "Engineering"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            },
            "description": "Filters combine with AND."
          }
        },
        {
          "name": "Paginate and sort",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Requested page and size', () => { pm.expect(body.page).to.eql(1); pm.expect(body.size).to.eql(5); });",
                  "pm.test('Sorted by salary desc', () => { const s = body.content.map(e => e.salary); pm.expect(s).to.eql([...s].sort((a, b) => b - a)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?page=1&size=5&sortBy=salary&sortDirection=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sortBy",
                  "value": "salary"
                },
                {
                  "key": "sortDirection",
                  "value": "desc"
                }
              ]
            },
            "description": "Second page of 5, sorted by salary descending. Allowed sortBy: id, fullName, email, department, designation, dateOfJoining, salary, employmentStatus."
          }
        },
